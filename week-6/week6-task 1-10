    // Store characters of s1
    for (int i = 0; i < s1.length(); i++) {
        char ch = s1.charAt(i);
        present[ch - 'a'] = true;
    }
    // Check characters of s2
    for (int i = 0; i < s2.length(); i++) {
        char ch = s2.charAt(i);
        if (present[ch - 'a']) {
            return "YES";
        }
    }
    return "NO";
}
